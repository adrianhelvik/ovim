{
  "name": "ovim-gui",
  "private": true,
  "version": "1.2.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "test": "vitest run",
    "icons:generate": "node scripts/generate-icons.mjs",
    "bundle": "npm run build && cd .. && cargo build --release --bin ovim-gui && tauri bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "dompurify": "^3.4.14",
    "marked": "^18.0.10",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.11"
  }
}
