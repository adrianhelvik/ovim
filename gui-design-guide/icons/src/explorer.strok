# @meaning Open or focus the project explorer and file tree.
# @tags navigation, explorer, files, tree, panel
documentsize 24x24

defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap butt
  stroke-linejoin miter
  stroke-miterlimit 3

shape frame template=rectangle
  round-corners 1

shape divider template=line

shape node template=rectangle
  fill currentColor
  stroke none
  round-corners 0.5

shape branch template=line

place frame shape=frame at=3,3 size=18x18
place divider shape=divider from=9,3 to=9,21
repeat i 3
  place node shape=node at=5,6+$i*5 size=2x2
place branch-a shape=branch from=11,7 to=18,7
place branch-b shape=branch from=11,12 to=18,12
place branch-c shape=branch from=11,17 to=16,17
