# @meaning Expand a collapsed row or move forward through hierarchy.
# @tags navigation, chevron, right, expand, breadcrumb
documentsize 24x24

defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap butt
  stroke-linejoin miter
  stroke-miterlimit 3

shape chevron template=path
  addpoint top at=8,4
  addpoint point at=16,12
  addpoint bottom at=8,20
  open

place chevron shape=chevron at=0,0
