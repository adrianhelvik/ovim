# @meaning Open Ovim AI chat, agent activity, or an AI-assisted action.
# @tags navigation, ai, agent, spark, assistant
documentsize 24x24

defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap butt
  stroke-linejoin miter
  stroke-miterlimit 3

shape primary template=path
  addpoint top at=13,2
  addpoint inner-tr at=15,9
  addpoint right at=22,11
  addpoint inner-br at=15,13
  addpoint bottom at=13,20
  addpoint inner-bl at=11,13
  addpoint left at=4,11
  addpoint inner-tl at=11,9
  close
  fill currentColor
  stroke none

shape satellite template=path
  addpoint top at=5,2
  addpoint right at=6,4
  addpoint bottom at=5,6
  addpoint left at=4,4
  close
  fill currentColor
  stroke none

place primary shape=primary at=0,0
place satellite shape=satellite at=0,0
