# @meaning Stop generation, cancel a running task, or terminate execution.
# @tags action, stop, cancel, terminate
documentsize 24x24

defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap butt
  stroke-linejoin miter
  stroke-miterlimit 3

shape stop template=rectangle
  fill currentColor
  stroke none
  round-corners 1

place stop shape=stop at=6,6 size=12x12
